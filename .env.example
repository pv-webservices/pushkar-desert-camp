# Confirm the production origin before publishing. Local builds remain noindex without it.
PUBLIC_SITE_URL=

# Build-time image generation only (scripts/generate-images.mjs). Never commit a real key,
# never expose it to browser code. Not needed for normal builds.
OPENAI_API_KEY=
# Optional overrides (defaults shown in scripts/image-gen/config.mjs)
# IMAGE_MODEL_FLARE=gpt-image-2.5-flare
# IMAGE_MODEL_SUNBURST=gpt-image-2.5-sunburst
# IMAGE_QUALITY_DEFAULT=medium
# IMAGE_QUALITY_PREMIUM=high
# IMAGE_SIZE_SQUARE=1024x1024
# IMAGE_SIZE_LANDSCAPE=1536x1024
# IMAGE_SIZE_PORTRAIT=1024x1536
