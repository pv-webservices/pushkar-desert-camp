---
import Icon from './Icon.astro';
// Variants: '' (maroon), 'amber', 'ghost-light', 'ghost-dark', 'text'
const { href = '/contact-us/', variant = '', class: cls = '', icon = 'arrow', size = '', ...rest } = Astro.props;
---
<a class:list={['button', variant && `button-${variant}`, size && `button-${size}`, cls]} href={href} {...rest}><span class="button-label"><slot /></span><span class="button-icon"><Icon name={icon} size={17} /></span></a>
