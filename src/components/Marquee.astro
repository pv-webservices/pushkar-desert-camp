---
const { items = ['Desert Safari', 'Camp Stay', 'Swiss Tent', 'Folk Dance', 'Fire Show', 'Poolside Moments', 'Pushkar, Rajasthan'] } = Astro.props as { items?: string[] };
const run = [...items, ...items];
---
<div class="marquee" aria-hidden="true">
  <div class="marquee-track">{run.map(item => <span class="marquee-item">{item}<svg viewBox="0 0 24 24" width="18" height="18"><path d="M12 2l2.2 7.8L22 12l-7.8 2.2L12 22l-2.2-7.8L2 12l7.8-2.2Z" fill="currentColor" /></svg></span>)}</div>
</div>
